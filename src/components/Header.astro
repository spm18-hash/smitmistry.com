---
import Social from "./Social.astro";
---

<header>
    <nav>
        <a href="/">{"Home"}</a>
        <a href="/">{"Blog"}</a>
        <a href="/">{"Work"}</a>
    </nav>

    <Social />
</header>

<style>
    header {
        height: 56px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        letter-spacing: -0.02em;

        & nav {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        & a:hover {
            color: var(--color-fg);
        }
    }
</style>
