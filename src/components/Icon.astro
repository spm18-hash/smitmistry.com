---
interface Props {
    title: string;
    class?: string;
}

const { title, class: className } = Astro.props;
---

<svg xmlns="http://www.w3.org/2000/svg" class={className}>
    <use href={`/sprite.svg#${title}`}></use>
</svg>

<style>
    svg {
        width: 24px;
        height: 24px;
    }
</style>
