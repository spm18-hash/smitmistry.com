---
interface Props {
    title: string;
    size?: string;
}

const { title, size = "1em" } = Astro.props;
---

<svg xmlns="http://www.w3.org/2000/svg">
    <use href={`/sprite.svg#${title}`}></use>
</svg>

<style define:vars={{ "icon-size": size }}>
    svg {
        font-size: var(--icon-size, 1em);
        width: 1em;
        height: 1em;
    }
</style>
