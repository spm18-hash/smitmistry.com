---
import Header from "../components/Header.astro";
import BaseHead, {
    type Props as HeadProps,
} from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";

interface Props extends HeadProps {
    class?: string;
}

const { ...head } = Astro.props;
---

<html lang="en" class:list={[Astro.props.class]}>
    <head>
        <BaseHead {...head} />
    </head>
    <body>
        <Header />
        <slot />
        <Footer />
    </body>
</html>

<style is:global>
    :root {
        --color-bg: oklch(98.5% 0 none) /* neutral-50 */;
        --color-fg: oklch(20.5% 0 none) /* neutral-900 */;
        --color-muted: oklch(43.9% 0 none) /* neutral-600 */;
        --color-border: oklch(92.2% 0 none) /* neutral-300 */;
        --color-link: oklch(35.06% 0.2216 269.1) /* google link */;
        --color-visited-link: oklch(39.95% 0.2044 307.9);

        .astro-code,
        .astro-code span {
            background-color: var(--color-bg) !important;
        }
    }

    * {
        font-weight: unset;
        padding: 0;
        box-sizing: border-box;
    }
    button {
        all: unset;
        cursor: pointer;
    }
    html {
        font-family: var(--font-sans);
    }

    code,
    pre {
        font-family: var(--font-mono);
    }

    a {
        color: var(--color-link);
        text-decoration: none;

        &:visited {
            color: var(--color-visited-link);
        }
    }

    h1,
    h2,
    h3,
    h4,
    h5,
    h6 {
        letter-spacing: -0.025em;
        font-weight: 500;
    }
</style>

<style>
    body {
        display: flex;
        flex-direction: column;
        max-width: 70ch;
        margin-inline: auto;
        padding-inline: 20px;
        background-color: var(--color-bg);
        color: var(--color-fg);
    }
</style>
